  "scriptRawCodeOfId": {
    "22": "const rootObjectId = game.world.id;\nconsole.log('[player_join_avatar_script] loaded rootObjectId', rootObjectId);\n\ngame.objectService.addObjectCreatedListener((player) => {\n  console.log('[player_join_avatar_script] join callback fired', player.id);\n  if (player.type !== 'player') return;\n  if (player.characterObjectId !== null) return;\n  \n  const spawnColumn = player.id % 4;\n  const spawnRow = Math.floor(player.id / 4) % 3;\n  const groupPosition = { x: (spawnColumn - 1.5) * 8.0, y: 15.0, z: spawnRow * 8.0 - 8.0 };\n\n  // Find one GamePig to use as a template\n  const allChildren = game.world.getChildren();\n  const pigs = allChildren.filter(c => c.name === \"GamePig\");\n  let templatePigId = null;\n  if (pigs.length > 0) {\n      templatePigId = pigs[0].id;\n  }\n\n  if (templatePigId) {\n      // Clone the pig template\n      const clonedPig = game.objectService.cloneObject(templatePigId, \"PlayerPig_\" + player.id);\n      \n      if (clonedPig) {\n          const collider = clonedPig.getChildren().find(c => c.name === \"physics_collider\");\n          const mesh = clonedPig.getChildren().find(c => c.name === \"mesh_1\");\n          const materialChild = mesh ? mesh.getChildren().find(c => c.name === \"material_1\") : null;\n\n          if (collider) {\n              collider.location.position = groupPosition;\n              \n              const anchor = collider.getChildren().find(c => c.name === \"mesh_anchor\");\n              \n              // Link mesh to the rotated anchor (or directly to collider if not found)\n              if (mesh) {\n                  mesh.physicalObjectId = anchor ? anchor.id : collider.id;\n                  if (materialChild) {\n                      mesh.material = { materialInfoId: materialChild.id };\n                  }\n              }\n\n              // Make collider transparent and absolutely unanchored\n              const colliderChild = collider.getChildren().find(c => c.name === \"physics_collider_child\");\n              if (colliderChild) {\n                  colliderChild.opacity = 0;\n                  colliderChild.isAnchored = false;\n                  // Set the head to the actual ball collider so the camera tracks properly!\n                  player.headObjectId = colliderChild.id;\n              }\n              \n              player.characterObjectId = collider.id;\n          }\n      }\n  } else {\n      console.log(\"Template pig not found, unable to spawn player\");\n  }\n}, \"player\");"
  },
