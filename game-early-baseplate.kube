  "scriptRawCodeOfId": {
    "3": "import {y} from './orbit_script'\ny()\nconst createVec3 = (x, y, z) => ({ x, y, z });\nconst addVec3 = (left, right) => createVec3(left.x + right.x, left.y + right.y, left.z + right.z);\nconst subtractVec3 = (left, right) => createVec3(left.x - right.x, left.y - right.y, left.z - right.z);\nconst multiplyVec3 = (vector, scalar) => createVec3(vector.x * scalar, vector.y * scalar, vector.z * scalar);\nconst scaleVec3AroundPoint = (position, scaleMultiplier, centerPoint) => {\n  return addVec3(centerPoint, multiplyVec3(subtractVec3(position, centerPoint), scaleMultiplier));\n};\nconst createPhysicsInfo = (position) => ({\n  location: { position, rotation: createVec3(0.0, 0.0, 0.0) },\n  movement: {\n    velocity: createVec3(0.0, 0.0, 0.0),\n    angularVelocity: createVec3(0.0, 0.0, 0.0),\n  },\n});\n\nconst rootObjectId = game.world.id;\nconsole.log('[player_join_avatar_script] loaded rootObjectId', rootObjectId);\n\n// --- PIG SETTINGS ---\nconst pigColorBody = { r: 0.96, g: 0.67, b: 0.74 };\nconst pigColorDark = { r: 0.82, g: 0.43, b: 0.57 };\n\n// --- HUMAN SETTINGS ---\nconst skinColor = { r: 0.9, g: 0.7, b: 0.5 };\nconst shirtColor = { r: 0.1, g: 0.3, b: 0.8 };\nconst pantsColor = { r: 0.2, g: 0.2, b: 0.2 };\n\nconst brickDensityFromMassAndSize = (size, mass) => {\n  const volume = Math.abs(size.x * size.y * size.z);\n  if (volume === 0) return 0;\n  return mass / volume;\n};\n\nconst ballDensityFromMassAndRadius = (radius, mass) => {\n  const volume = Math.abs((4.0 / 3.0) * Math.PI * radius * radius * radius);\n  if (volume === 0) return 0;\n  return mass / volume;\n};\n\nconst createAvatarBrick = (name, size, position, mass, color, parentId) => {\n  return game.objectService.createObject(name, {\n    type: 'brick',\n    material: null,\n    opacity: 1.0,\n    color,\n    isAlwaysOnTop: false,\n    size,\n    isWalkthrough: false,\n    isAnchored: false,\n    density: brickDensityFromMassAndSize(size, mass),\n    ...createPhysicsInfo(position),\n  }, parentId).id;\n};\n\nconst createAvatarBall = (name, radius, position, mass, color, parentId) => {\n  return game.objectService.createObject(name, {\n    type: 'ball',\n    material: null,\n    opacity: 1.0,\n    color,\n    isAlwaysOnTop: false,\n    radius,\n    isWalkthrough: false,\n    isAnchored: false,\n    density: ballDensityFromMassAndRadius(radius, mass),\n    ...createPhysicsInfo(position),\n  }, parentId).id;\n};\n\nconst scaleRigidGroupAroundPoint = (rigidGroupId, scaleMultiplier, centerPoint) => {\n  const rigidGroup = game.world.getChildren().find((child) => child.id === rigidGroupId);\n  if (rigidGroup === undefined) return;\n  if (rigidGroup.type !== 'rigidGroup') return;\n\n  rigidGroup.location.position = scaleVec3AroundPoint(rigidGroup.location.position, scaleMultiplier, centerPoint);\n  for (const child of rigidGroup.getChildren()) {\n    game.objectService.scaleObject(child.id, scaleMultiplier, centerPoint);\n  }\n};\n\nconst createPigAvatar = (playerId, groupPosition) => {\n  const rigidGroupId = game.objectService.createObject('player_pig', {\n    type: 'rigidGroup',\n    followSkeletonId: null,\n    followJointNameOfChildName: null,\n    attachmentOffsetOfChildName: {},\n    ...createPhysicsInfo(groupPosition),\n  }, rootObjectId).id;\n  \n  createAvatarBrick('pig_body', createVec3(2.6, 1.7, 4.2), addVec3(groupPosition, createVec3(0.0, 0.0, 0.0)), 6.0, pigColorBody, rigidGroupId);\n  const pigHeadId = createAvatarBall('pig_head', 1.05, addVec3(groupPosition, createVec3(0.0, 0.55, 2.85)), 1.5, pigColorBody, rigidGroupId);\n  createAvatarBrick('pig_snout', createVec3(1.15, 0.8, 0.9), addVec3(groupPosition, createVec3(0.0, 0.35, 3.85)), 0.6, pigColorDark, rigidGroupId);\n  createAvatarBrick('pig_left_ear', createVec3(0.45, 0.7, 0.45), addVec3(groupPosition, createVec3(-0.55, 1.55, 2.65)), 0.3, pigColorDark, rigidGroupId);\n  createAvatarBrick('pig_right_ear', createVec3(0.45, 0.7, 0.45), addVec3(groupPosition, createVec3(0.55, 1.55, 2.65)), 0.3, pigColorDark, rigidGroupId);\n  createAvatarBrick('pig_front_left_leg', createVec3(0.45, 1.4, 0.45), addVec3(groupPosition, createVec3(-0.9, -1.3, 1.15)), 0.8, pigColorDark, rigidGroupId);\n  createAvatarBrick('pig_front_right_leg', createVec3(0.45, 1.4, 0.45), addVec3(groupPosition, createVec3(0.9, -1.3, 1.15)), 0.8, pigColorDark, rigidGroupId);\n  createAvatarBrick('pig_back_left_leg', createVec3(0.45, 1.4, 0.45), addVec3(groupPosition, createVec3(-0.9, -1.3, -1.15)), 0.8, pigColorDark, rigidGroupId);\n  createAvatarBrick('pig_back_right_leg', createVec3(0.45, 1.4, 0.45), addVec3(groupPosition, createVec3(0.9, -1.3, -1.15)), 0.8, pigColorDark, rigidGroupId);\n  createAvatarBall('pig_tail', 0.32, addVec3(groupPosition, createVec3(0.0, 0.55, -2.45)), 0.2, pigColorDark, rigidGroupId);\n  \n  return { rigidGroupId, headId: pigHeadId };\n};\n\nconst createHumanAvatar = (playerId, groupPosition) => {\n  const rigidGroupId = game.objectService.createObject('player_human', {\n    type: 'rigidGroup',\n    followSkeletonId: null,\n    followJointNameOfChildName: null,\n    attachmentOffsetOfChildName: {},\n    ...createPhysicsInfo(groupPosition),\n  }, rootObjectId).id;\n  \n  // Torso\n  createAvatarBrick('human_torso', createVec3(2.0, 3.0, 1.0), addVec3(groupPosition, createVec3(0.0, 0.0, 0.0)), 4.0, shirtColor, rigidGroupId);\n  // Head\n  const headId = createAvatarBrick('human_head', createVec3(1.5, 1.5, 1.5), addVec3(groupPosition, createVec3(0.0, 2.25, 0.0)), 1.5, skinColor, rigidGroupId);\n  // Arms\n  createAvatarBrick('human_left_arm', createVec3(1.0, 3.0, 1.0), addVec3(groupPosition, createVec3(-1.5, 0.0, 0.0)), 1.5, skinColor, rigidGroupId);\n  createAvatarBrick('human_right_arm', createVec3(1.0, 3.0, 1.0), addVec3(groupPosition, createVec3(1.5, 0.0, 0.0)), 1.5, skinColor, rigidGroupId);\n  // Legs\n  createAvatarBrick('human_left_leg', createVec3(1.0, 3.0, 1.0), addVec3(groupPosition, createVec3(-0.5, -3.0, 0.0)), 2.0, pantsColor, rigidGroupId);\n  createAvatarBrick('human_right_leg', createVec3(1.0, 3.0, 1.0), addVec3(groupPosition, createVec3(0.5, -3.0, 0.0)), 2.0, pantsColor, rigidGroupId);\n  \n  return { rigidGroupId, headId };\n};\n\nlet spawnedFirstCharacter = false;\n\ngame.objectService.addObjectCreatedListener((player) => {\n  console.log('[player_join_avatar_script] join callback fired', player.id);\n  if (player.type !== 'player') return;\n  if (player.characterObjectId !== null) return;\n  \n  const spawnColumn = player.id % 4;\n  const spawnRow = Math.floor(player.id / 4) % 3;\n  const groupPosition = createVec3((spawnColumn - 1.5) * 8.0, 8.0, spawnRow * 8.0 - 8.0);\n\n  let avatar;\n  if (!spawnedFirstCharacter) {\n    spawnedFirstCharacter = true;\n    avatar = createHumanAvatar(player.id, groupPosition);\n  } else {\n    avatar = createPigAvatar(player.id, groupPosition);\n  }\n  \n  player.headObjectId = avatar.headId;\n  player.characterObjectId = avatar.rigidGroupId;\n\n  const scaleLater = async () => {\n    const startTime = Date.now();\n    while (Date.now() - startTime < 5000) {\n      await tick();\n    }\n    const controlsObj = game.world.getChildren().find((child) => child.id === avatar.rigidGroupId);\n    if (controlsObj) {\n      game.objectService.scaleObject(avatar.rigidGroupId, 0.5, createVec3(0.0, 0.0, 0.0));\n      console.log('Scaled player down by 50% from the world origin');\n    }\n  };\n  scaleLater();\n}, \"player\");\n\nawait tick()",
    "115": " const movingObject = game.world.getChildren().find((child) => child.name === 'ball1');\nlet angle = 0;\n\n\nlet x = () => {\n\n}\n\nconsole.log('aaaaa11111')\nlet y = () => {\n\n  console.log('bbbbbbbb111111')\n  // let o2 = game.objectService.cloneObject(movingObject.id, \"movingobject2\");\n  // game.objectService.scaleObject(o2, 10, {x:0,y:0,z:0})\n  x()\n}\n\nexport { y }\n\n\n\n// while (true) {\n//   if (movingObject !== undefined && movingObject.type === 'ball') {\n//     movingObject.location.position.x = Math.cos(angle) * 6.0;\n//     movingObject.location.position.y = 5.0;\n//     movingObject.location.position.z = Math.sin(angle) * 6.0;\n//     angle += 0.05;\n//   }\n//   await tick();\n// }\n",
    "106": "console.log('local script is running and says hello');\n",
    "110": "'use server'\n\nconsole.log('QQQQQQQQQQQ22222')\nexport const x = async (banana) => {\n\nconsole.log('SERVER RECEIVED!!!!', banana)\n\nreturn banana+10\n}",
    "111": "const Nested = ({x,setX})=>{\n  return <div className=\"border border-red-500 p-2\" onClick={()=>{setX(v=>v-1)}}>{x}</div>\n}\n\nconst StateTest=  ({init})=>{\n  const [x,setX] = useState(init)\n\n  return <div onClick={()=>{setX(v=>v+1)}}>{x}</div>\n\n}\n\nconst WelcomeUI = () => {\n  const [isOpen, setIsOpen] = useState(true);\n  const [count, setCount] = useState(1)\n  if (!isOpen) {\n    return <div className=\"border border-red-500\"></div>;\n  }\n\n  return (\n    <div className=\"bg-slate-900 border border-red-500 p-8 rounded-xl flex flex-col items-center justify-center gap-6\">\n      <div className=\"text-3xl font-sans text-white border border-red-500 p-2\">Welcome to the Game!</div>\n      <div className=\"text-lg font-sans text-slate-300 border border-red-500 p-2\">We are glad you are here.</div>\n      <div \n        className=\"bg-blue-700 hover:scale-105 transition-transform duration-150 px-8 py-3 rounded-lg text-white font-sans text-xl border border-red-500\"\n        onClick={() => setIsOpen(false)}\n      >\n        Play\n      </div>\n      <Nested x={count} setX={setCount} /> \n      <StateTest init={0}/>\n      <StateTest init={6}/>\n    </div>\n  );\n};\n\ngame.guiService.show(\"welcome_ui\", WelcomeUI, \"center\");"
  },
