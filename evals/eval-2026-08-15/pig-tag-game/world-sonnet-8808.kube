  "scriptRawCodeOfId": {
    "74": "'use server'\n\n// Clones the permanent master pig (parked out of view, named \"PigSource\") for\n// every joining player and wires up their character/head. New players always\n// appear in the lobby -- round_manager.ts moves them onto the map once a round\n// actually starts.\n// (We use cloneObject on a live master copy rather than a template: pasted\n// templates aren't available inside a fresh playtest/production server snapshot.\n// We look the master up by name rather than object id, because object ids are\n// not stable between the editor session and a freshly loaded server snapshot.)\n\nconst LOBBY_FLOOR_HALF = 13;\n\nconst pigRootIdByPlayerObjId = new Map<number, number>();\n\nfunction randomLobbySpot() {\n  return {\n    x: (Math.random() * 2 - 1) * LOBBY_FLOOR_HALF,\n    y: 45.55,\n    z: (Math.random() * 2 - 1) * LOBBY_FLOOR_HALF,\n  };\n}\n\ngame.objectService.addObjectCreatedListener((player) => {\n  try {\n    console.log(`[spawn_players] player joined: ${player.userid}`);\n    const pigMaster = game.objectService.getObjectByName(\"PigSource\");\n    if (!pigMaster) {\n      console.log(`[spawn_players] ERROR: master pig \"PigSource\" not found`);\n      return;\n    }\n    const pigRoot = game.objectService.cloneObject(pigMaster.id, `Pig_${player.userid}`);\n    const body = pigRoot.getChild(\"PigBody\");\n    if (!body) {\n      console.log(`[spawn_players] ERROR: cloned pig has no PigBody child`);\n      return;\n    }\n\n    game.objectService.moveObjectTo(body.id, randomLobbySpot());\n    player.headObjectId = body.id;\n    player.characterObjectId = body.id;\n\n    pigRootIdByPlayerObjId.set(player.id, pigRoot.id);\n    console.log(`[spawn_players] pig spawned for ${player.userid} at pigRoot=${pigRoot.id} body=${body.id}`);\n  } catch (e) {\n    console.log(`[spawn_players] EXCEPTION: ${e}`);\n  }\n}, \"player\");\n\ngame.objectService.addObjectDeletedListener((playerObjectId) => {\n  const pigRootId = pigRootIdByPlayerObjId.get(playerObjectId);\n  if (pigRootId !== undefined) {\n    game.objectService.deleteObject(pigRootId);\n    pigRootIdByPlayerObjId.delete(playerObjectId);\n  }\n}, \"player\");\n",
    "76": "'use client'\n\nimport { reportCollision } from './round_manager';\n\n// Walks up from whatever subitem collided to the pig's RigidGroup root\n// (identified by having a \"Torso\" child), so we ignore collisions with\n// walls, crates, rocks, etc.\ngame.collisionService.addCollisionListener((obj1: any, obj2: any) => {\n  function findPigRoot(obj: any) {\n    let current = obj;\n    while (current) {\n      if (current.type === \"rigidGroup\" && current.getChild(\"Torso\")) {\n        return current;\n      }\n      current = current.parent;\n    }\n    return null;\n  }\n\n  const root1 = findPigRoot(obj1);\n  const root2 = findPigRoot(obj2);\n  if (root1 && root2 && root1.id !== root2.id) {\n    reportCollision(root1.id, root2.id);\n  }\n});\n",
    "75": "'use server'\n\n// Shared game phase / countdown / result text is broadcast to clients by writing\n// a small JSON blob into the \"GameState\" marker object's `name` field. Every\n// object is replicated automatically, so a client script can just read it back --\n// no client RPC needed. Looked up by name (not object id) since ids are not\n// stable between the editor session and a freshly loaded server snapshot.\n\ntype Phase = 'lobby' | 'playing' | 'ended';\n\nconst LOBBY_MS = 30_000;\nconst ROUND_MS = 5 * 60 * 1000;\nconst RESULT_PAUSE_MS = 6_000;\n\nconst MAP_SPAWNS = [\n  { x: 0, y: 1.05, z: 50 },\n  { x: 0, y: 1.05, z: -50 },\n  { x: 50, y: 1.05, z: 0 },\n  { x: -50, y: 1.05, z: 0 },\n  { x: 35, y: 1.05, z: 35 },\n  { x: -35, y: 1.05, z: -35 },\n  { x: -35, y: 1.05, z: 35 },\n  { x: 35, y: 1.05, z: -35 },\n  { x: 65, y: 1.05, z: 65 },\n  { x: -65, y: 1.05, z: -65 },\n];\n\nconst PIG_COLOR = { r: 0.93, g: 0.62, b: 0.68 };\nconst TAGGER_COLOR = { r: 0.75, g: 0.08, b: 0.08 };\nconst PIG_COLOR_PARTS = [\"Torso\", \"Head\", \"LegFL\", \"LegFR\", \"LegBL\", \"LegBR\", \"EarL\", \"EarR\", \"Snout\"];\n\nconst LOBBY_FLOOR_HALF = 13;\n\nlet phase: Phase = 'lobby';\nlet phaseEndTime = getTime() + LOBBY_MS;\nconst taggerUserIds = new Set<string>();\nlet phaseTimeoutHandle: ReturnType<typeof setTimeout> | null = null;\n\nfunction randomLobbySpot() {\n  return {\n    x: (Math.random() * 2 - 1) * LOBBY_FLOOR_HALF,\n    y: 45.55,\n    z: (Math.random() * 2 - 1) * LOBBY_FLOOR_HALF,\n  };\n}\n\nfunction shuffled<T>(items: T[]): T[] {\n  const copy = [...items];\n  for (let i = copy.length - 1; i > 0; i--) {\n    const j = Math.floor(Math.random() * (i + 1));\n    [copy[i], copy[j]] = [copy[j], copy[i]];\n  }\n  return copy;\n}\n\nfunction recolorPig(characterObjectId: number, isTagger: boolean) {\n  const root = game.objectService.getObjectById(characterObjectId);\n  if (!root) return;\n  const color = isTagger ? TAGGER_COLOR : PIG_COLOR;\n  for (const partName of PIG_COLOR_PARTS) {\n    const part = root.getChild(partName);\n    if (part && (part.type === \"ball\" || part.type === \"brick\" || part.type === \"cylinder\")) {\n      part.color = color;\n    }\n  }\n  const horn = root.getChild(\"Horn\");\n  if (horn && (horn.type === \"ball\" || horn.type === \"brick\" || horn.type === \"cylinder\")) {\n    horn.opacity = isTagger ? 1 : 0;\n  }\n}\n\nfunction broadcast(resultText: string | null) {\n  const stateHolder = game.objectService.getObjectByName(\"GameState\");\n  if (!stateHolder) return;\n  stateHolder.name = JSON.stringify({\n    phase,\n    endTimeMs: phaseEndTime,\n    resultText,\n    taggerCount: taggerUserIds.size,\n  });\n}\n\nfunction clearPhaseTimeout() {\n  if (phaseTimeoutHandle !== null) {\n    clearTimeout(phaseTimeoutHandle);\n    phaseTimeoutHandle = null;\n  }\n}\n\nfunction startLobby() {\n  console.log(`[round_manager] entering lobby phase`);\n  clearPhaseTimeout();\n  phase = 'lobby';\n  phaseEndTime = getTime() + LOBBY_MS;\n  taggerUserIds.clear();\n\n  for (const p of game.playerService.getAllPlayers()) {\n    if (p.characterObjectId) {\n      recolorPig(p.characterObjectId, false);\n      game.objectService.moveObjectTo(p.characterObjectId, randomLobbySpot());\n    }\n  }\n\n  broadcast(null);\n  phaseTimeoutHandle = setTimeout(startRound, LOBBY_MS);\n}\n\nfunction startRound() {\n  clearPhaseTimeout();\n  const players = game.playerService.getAllPlayers().filter((p) => p.characterObjectId !== null);\n\n  if (players.length < 1) {\n    // Nobody around to play with yet -- wait a bit and check again.\n    phaseTimeoutHandle = setTimeout(startLobby, 2000);\n    return;\n  }\n\n  phase = 'playing';\n  phaseEndTime = getTime() + ROUND_MS;\n  taggerUserIds.clear();\n\n  const taggerIndex = Math.floor(Math.random() * players.length);\n  const spawns = shuffled(MAP_SPAWNS);\n\n  players.forEach((p, i) => {\n    const isTagger = i === taggerIndex;\n    if (isTagger) taggerUserIds.add(p.userid);\n    const spot = spawns[i % spawns.length];\n    game.objectService.moveObjectTo(p.characterObjectId as number, spot);\n    recolorPig(p.characterObjectId as number, isTagger);\n  });\n\n  console.log(`[round_manager] round started with ${players.length} players, tagger=${players[taggerIndex].userid}`);\n  broadcast(null);\n  phaseTimeoutHandle = setTimeout(() => endRound('pigs'), ROUND_MS);\n}\n\nfunction endRound(winner: 'pigs' | 'taggers') {\n  console.log(`[round_manager] round ended, winner=${winner}`);\n  clearPhaseTimeout();\n  phase = 'ended';\n  phaseEndTime = getTime();\n\n  broadcast(\n    winner === 'pigs'\n      ? 'The pigs survived! Pigs win the round.'\n      : 'Every pig got tagged! Taggers win the round.'\n  );\n\n  phaseTimeoutHandle = setTimeout(startLobby, RESULT_PAUSE_MS);\n}\n\nexport async function reportCollision(objId1: number, objId2: number) {\n  if (phase !== 'playing') return;\n\n  const players = game.playerService.getAllPlayers();\n  const p1 = players.find((p) => p.characterObjectId === objId1);\n  const p2 = players.find((p) => p.characterObjectId === objId2);\n  if (!p1 || !p2) return;\n\n  const p1Tagger = taggerUserIds.has(p1.userid);\n  const p2Tagger = taggerUserIds.has(p2.userid);\n  if (p1Tagger === p2Tagger) return; // both taggers or both pigs -- nothing to do\n\n  const newlyTagged = p1Tagger ? p2 : p1;\n  if (taggerUserIds.has(newlyTagged.userid)) return; // already processed\n\n  taggerUserIds.add(newlyTagged.userid);\n  if (newlyTagged.characterObjectId) {\n    recolorPig(newlyTagged.characterObjectId, true);\n  }\n  console.log(`[round_manager] ${newlyTagged.userid} got tagged (${taggerUserIds.size}/${players.length} now taggers)`);\n  broadcast(null);\n\n  if (taggerUserIds.size >= players.length) {\n    endRound('taggers');\n  }\n}\n\n// Kick off the very first lobby countdown when the server boots.\nstartLobby();\n",
    "116": "'use client'\n\n// Reads the shared game state that round_manager.ts (Server) writes into the\n// GameState marker object's `name` field every phase change. Object properties\n// replicate to every client automatically, so no RPC is needed here. Looked up\n// by name since object ids are not stable across a fresh server snapshot.\n\ntype RoundState = {\n  phase: 'lobby' | 'playing' | 'ended';\n  endTimeMs: number;\n  resultText: string | null;\n  taggerCount: number;\n};\n\nconst DEFAULT_STATE: RoundState = {\n  phase: 'lobby',\n  endTimeMs: getTime() + 30_000,\n  resultText: null,\n  taggerCount: 0,\n};\n\nconst uiState = createState<RoundState>(DEFAULT_STATE);\n\nsetInterval(() => {\n  const holder = game.objectService.getObjectByName(\"GameState\");\n  if (!holder) return;\n  try {\n    uiState.set(JSON.parse(holder.name) as RoundState);\n  } catch {\n    // holder.name hasn't been written yet -- keep the previous state\n  }\n}, 400);\n\nfunction formatTime(ms: number) {\n  const totalSeconds = Math.max(0, Math.ceil(ms / 1000));\n  const m = Math.floor(totalSeconds / 60);\n  const s = totalSeconds % 60;\n  return `${m}:${s.toString().padStart(2, \"0\")}`;\n}\n\nfunction RoundHud() {\n  const state = uiState.get();\n  const remaining = formatTime(state.endTimeMs - getTime());\n\n  const phaseLabel =\n    state.phase === \"lobby\"\n      ? `Next round starts in ${remaining}`\n      : state.phase === \"playing\"\n      ? `Tag other pigs to turn them red -- ${remaining} left`\n      : \"Round over\";\n\n  return (\n    <div className=\"flex flex-col items-center gap-1 px-5 py-3 rounded-2xl bg-black/60\">\n      <div className=\"text-lg font-bold text-white\">PIG TAG</div>\n      <div className=\"text-base text-white\">{phaseLabel}</div>\n      {state.resultText ? (\n        <div className=\"text-base font-bold text-yellow-300\">{state.resultText}</div>\n      ) : null}\n    </div>\n  );\n}\n\ngame.guiService.show(\"pig-tag-hud\", () => <RoundHud />, \"top\");\n",
    "100": "'use client'\n\n// Speeds up the pig's idle \"breathing\" animation clock while it is moving,\n// so it reads as a bouncy waddle instead of a static breathing pose.\n// Runs once per pasted pig copy; reads local velocity so it needs no server round trip.\n\nconst pigRoot = script.parent;\nconst body = pigRoot ? pigRoot.getChild(\"PigBody\") : null;\nconst clock = pigRoot ? pigRoot.getChild(\"BreathClock\") : null;\n\nif (body && clock) {\n  setInterval(() => {\n    const vel = game.objectService.getVelocityRelativeToGround(body.id);\n    const groundSpeed = Math.sqrt(vel.x * vel.x + vel.z * vel.z);\n    const targetSpeed = groundSpeed > 0.5 ? 3.2 : 1.0;\n    game.clockService.setSpeed(clock.id, targetSpeed);\n  }, 200);\n}\n"
  },
