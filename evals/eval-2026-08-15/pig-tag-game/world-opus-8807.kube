  "scriptRawCodeOfId": {
    "4092": "'use server'\nimport { applyState, flash } from './game_client';\n\n// ---------- tuning ----------\nconst LOBBY_MS = 6000;\nconst ROUND_MS = 5 * 60 * 1000;\nconst RESULT_MS = 12000;\nconst GRACE_MS = 0;\nconst GROUND_Y = 2;\n\nconst PIG_COLORS = {\n  torso: { r: 0.96, g: 0.70, b: 0.74 },\n  snout: { r: 0.90, g: 0.55, b: 0.60 },\n  leg: { r: 0.32, g: 0.24, b: 0.24 },\n  eye: { r: 0.12, g: 0.10, b: 0.10 },\n};\nconst TAG_COLORS = {\n  torso: { r: 0.86, g: 0.07, b: 0.09 },\n  snout: { r: 1.0, g: 0.42, b: 0.15 },\n  leg: { r: 0.42, g: 0.03, b: 0.04 },\n  eye: { r: 1.0, g: 0.93, b: 0.25 },\n};\n\nconst LOBBY_SPAWNS: number[][] = [\n  [326, 0], [324, 22], [310, 30], [300, 30], [290, 30], [276, 22],\n  [276, -22], [290, -30], [300, -30], [310, -30], [324, -22], [326, -12],\n];\nconst ARENA_SPAWNS: number[][] = [\n  [0, -170], [60, -170], [-60, -175], [150, -170], [-150, -30], [-170, 20],\n  [10, -185], [30, 170], [170, 60], [175, -40], [-100, 30], [100, 60],\n  [-170, 170], [170, 175], [-40, 130], [60, 100],\n];\n\n// ---------- state ----------\ntype Rec = {\n  userid: string; playerId: number; rootId: number; bodyId: number; headId: number; tagger: boolean;\n};\nconst byPlayer = new Map<number, Rec>();\nconst byUser = new Map<string, Rec>();\nconst byBody = new Map<number, Rec>();\n\nlet phase: 'lobby' | 'playing' | 'ended' = 'lobby';\nlet phaseEnd = 0;\nlet roundStart = 0;\nlet winner: 'taggers' | 'pigs' | null = null;\nlet spawnCursor = 0;\nlet charactersGroupId = 0;\n\nfunction counts() {\n  let taggers = 0, runners = 0;\n  byUser.forEach((r) => { if (r.tagger) taggers++; else runners++; });\n  return { taggers, runners };\n}\n\nfunction paint(rec: Rec) {\n  const body = game.objectService.getObjectById(rec.bodyId);\n  if (!body) return;\n  const c = rec.tagger ? TAG_COLORS : PIG_COLORS;\n  for (const ch of body.getChildren()) {\n    const n = ch.name;\n    if (n === 'Pig_Torso' || n === 'Pig_Head' || n === 'Pig_EarL' || n === 'Pig_EarR' || n === 'Pig_Tail') {\n      (ch as { color: { r: number; g: number; b: number } }).color = c.torso;\n    } else if (n === 'Pig_Snout') {\n      (ch as { color: { r: number; g: number; b: number } }).color = c.snout;\n    } else if (n === 'Pig_EyeL' || n === 'Pig_EyeR') {\n      (ch as { color: { r: number; g: number; b: number } }).color = c.eye;\n    } else if (n === 'Pig_LegFL' || n === 'Pig_LegFR' || n === 'Pig_LegBL' || n === 'Pig_LegBR') {\n      (ch as { color: { r: number; g: number; b: number } }).color = c.leg;\n    }\n  }\n  const player = game.objectService.getObjectById(rec.playerId);\n  if (player && player.type === 'player') {\n    player.physicsControls = {\n      jumpHeight: 3, stepHeight: 2.4,\n      speed: rec.tagger ? 38 : 34,\n      acceleration: 170,\n    };\n  }\n}\n\nfunction placeAt(rec: Rec, x: number, z: number) {\n  game.objectService.moveObjectTo(rec.bodyId, { x, y: GROUND_Y + 5, z });\n  const body = game.objectService.getObjectById(rec.bodyId);\n  if (body) (body as unknown as { movement: { velocity: { x: number; y: number; z: number }; angularVelocity: { x: number; y: number; z: number } } }).movement = { velocity: { x: 0, y: 0, z: 0 }, angularVelocity: { x: 0, y: 0, z: 0 } };\n}\n\nfunction sendTo(rec: Rec) {\n  const c = counts();\n  applyState(rec.userid, JSON.stringify({\n    phase, phaseEnd, winner,\n    role: rec.tagger ? 'tagger' : 'pig',\n    myBodyId: rec.bodyId,\n    taggers: c.taggers, runners: c.runners,\n    total: byUser.size,\n  }));\n}\nfunction broadcast() { byUser.forEach((r) => sendTo(r)); }\n\ntype PlayerLike = {\n  id: number; userid: string;\n  characterObjectId: number | null; headObjectId: number | null;\n};\nfunction spawnPig(player: PlayerLike) {\n  const root = game.templateService.pasteTemplate('pig', charactersGroupId);\n  if (!root) return;\n  root.name = 'Pig_' + player.userid;\n  const body = root.getChild('PigBody');\n  if (!body) return;\n  let head: { id: number } | null = null;\n  for (const ch of body.getChildren()) if (ch.name === 'Pig_Head') head = ch;\n  game.objectService.setObjectAnchored(body.id, false);\n  const rec: Rec = {\n    userid: player.userid, playerId: player.id, rootId: root.id, bodyId: body.id,\n    headId: head ? head.id : body.id, tagger: false,\n  };\n  byPlayer.set(player.id, rec);\n  byUser.set(player.userid, rec);\n  byBody.set(body.id, rec);\n\n  if (phase === 'playing') {\n    rec.tagger = true;\n    const s = ARENA_SPAWNS[spawnCursor++ % ARENA_SPAWNS.length];\n    placeAt(rec, s[0], s[1]);\n  } else {\n    const s = LOBBY_SPAWNS[spawnCursor++ % LOBBY_SPAWNS.length];\n    placeAt(rec, s[0], s[1]);\n  }\n  paint(rec);\n  console.log('[pigtag] spawned pig for ' + player.userid + ' body=' + body.id + ' head=' + rec.headId + ' phase=' + phase);\n  player.characterObjectId = body.id;\n  player.headObjectId = rec.headId;\n  sendTo(rec);\n}\n\nfunction removePlayer(playerId: number) {\n  const rec = byPlayer.get(playerId);\n  if (!rec) return;\n  byPlayer.delete(playerId);\n  byUser.delete(rec.userid);\n  byBody.delete(rec.bodyId);\n  game.objectService.deleteObject(rec.rootId);\n  if (phase === 'playing') checkWin();\n  broadcast();\n}\n\nfunction startLobby() {\n  phase = 'lobby';\n  winner = null;\n  phaseEnd = getTime() + LOBBY_MS;\n  let i = 0;\n  byUser.forEach((rec) => {\n    rec.tagger = false;\n    const s = LOBBY_SPAWNS[i++ % LOBBY_SPAWNS.length];\n    placeAt(rec, s[0], s[1]);\n    paint(rec);\n  });\n  broadcast();\n}\n\nfunction startRound() {\n  const all: Rec[] = [];\n  byUser.forEach((r) => all.push(r));\n  const it = Math.floor(Math.random() * all.length);\n  let i = 0;\n  for (const rec of all) {\n    rec.tagger = (i === it);\n    const s = ARENA_SPAWNS[(i + it * 5) % ARENA_SPAWNS.length];\n    placeAt(rec, s[0], s[1]);\n    paint(rec);\n    i++;\n  }\n  phase = 'playing';\n  console.log('[pigtag] ROUND START players=' + all.length + ' tagger=' + (all[it] ? all[it].userid : 'none'));\n  roundStart = getTime();\n  phaseEnd = roundStart + ROUND_MS;\n  winner = null;\n  broadcast();\n}\n\nfunction endRound(who: 'taggers' | 'pigs') {\n  phase = 'ended';\n  console.log('[pigtag] ROUND OVER winner=' + who);\n  winner = who;\n  phaseEnd = getTime() + RESULT_MS;\n  broadcast();\n}\n\nfunction checkWin() {\n  if (phase !== 'playing') return;\n  const c = counts();\n  if (byUser.size >= 1 && c.runners === 0) endRound('taggers');\n}\n\nfunction convert(rec: Rec) {\n  if (rec.tagger) return;\n  rec.tagger = true;\n  console.log('[pigtag] TAGGED ' + rec.userid);\n  paint(rec);\n  byUser.forEach((r) => flash(r.userid, rec.userid + ' got tagged!'));\n  broadcast();\n  checkWin();\n}\n\n// ---------- client-callable ----------\nexport async function reportContact(bodyA: number, bodyB: number) {\n  console.log('[pigtag] contact ' + bodyA + ' ' + bodyB + ' phase=' + phase);\n  if (phase !== 'playing') return false;\n  if (typeof bodyA !== 'number' || typeof bodyB !== 'number') return false;\n  if (getTime() - roundStart < GRACE_MS) return false;\n  const a = byBody.get(bodyA);\n  const b = byBody.get(bodyB);\n  if (!a || !b || a === b) return false;\n  if (a.tagger === b.tagger) return false;\n  convert(a.tagger ? b : a);\n  return true;\n}\n\n// ---------- boot ----------\nconst worldGroup = game.objectService.getObjectByName('world');\nconst src = game.objectService.getObjectByName('PigSource');\ncharactersGroupId = worldGroup ? worldGroup.id : 1;\nconst holder = game.objectService.createObject('Characters', { type: 'group' }, charactersGroupId);\nif (holder) charactersGroupId = holder.id;\nif (src) game.templateService.cutObjectToTemplate(src.id, 'pig');\nconsole.log('[pigtag] boot src=' + (src ? src.id : 'MISSING') + ' chars=' + charactersGroupId);\n\ngame.objectService.addObjectCreatedListener((player) => { spawnPig(player); }, 'player');\ngame.objectService.addObjectDeletedListener((playerId) => { removePlayer(playerId); }, 'player');\n\nstartLobby();\n\nsetInterval(() => {\n  const now = getTime();\n  if (phase === 'lobby') {\n    if (now >= phaseEnd) {\n      if (byUser.size >= 2) startRound();\n      else phaseEnd = now + LOBBY_MS;\n    }\n  } else if (phase === 'playing') {\n    if (now >= phaseEnd) endRound('pigs');\n  } else if (phase === 'ended') {\n    if (now >= phaseEnd) startLobby();\n  }\n}, 500);\n\nsetInterval(() => { broadcast(); }, 1000);\n",
    "4093": "'use client'\nimport { reportContact } from './game_server';\n\ntype State = {\n  phase: 'lobby' | 'playing' | 'ended';\n  phaseEnd: number;\n  winner: 'taggers' | 'pigs' | null;\n  role: 'tagger' | 'pig';\n  myBodyId: number;\n  taggers: number;\n  runners: number;\n  total: number;\n};\n\nconst state = createState<State | null>(null);\nconst toast = createState<string>('');\nconst ticker = createState<number>(0);\nsetInterval(() => ticker.set((n) => n + 1), 250);\n\nexport async function applyState(userid: string, json: string) {\n  if (typeof json !== 'string') return;\n  state.set(JSON.parse(json) as State);\n}\n\nexport async function flash(userid: string, message: string) {\n  if (typeof message !== 'string') return;\n  toast.set(message);\n  setTimeout(() => { if (toast.get() === message) toast.set(''); }, 2600);\n}\n\ntype ObjLike = { id: number; type: string; parent: ObjLike | null };\nfunction rigidRootId(o: ObjLike | null): number | null {\n  let cur: ObjLike | null = o;\n  while (cur && cur.type !== 'rigidGroup') cur = cur.parent;\n  return cur ? cur.id : null;\n}\n\nlet ncol = 0;\ngame.collisionService.addCollisionListener((o1, o2) => {\n  ncol++;\n  if (o1.name.indexOf('Pig_') === 0 || o2.name.indexOf('Pig_') === 0) console.log('[pigtag] raw collision ' + o1.name + ' <-> ' + o2.name);\n  const s = state.get();\n  if (!s || s.phase !== 'playing') return;\n  const a = rigidRootId(o1 as unknown as ObjLike);\n  const b = rigidRootId(o2 as unknown as ObjLike);\n  if (a === null || b === null || a === b) return;\n  if (a !== s.myBodyId && b !== s.myBodyId) return;\n  console.log('[pigtag] my collision ' + a + ' <-> ' + b);\n  reportContact(a, b);\n});\n\nfunction clock(ms: number) {\n  const total = Math.max(0, Math.ceil(ms / 1000));\n  const m = Math.floor(total / 60);\n  const s = total % 60;\n  return m + ':' + (s < 10 ? '0' + s : '' + s);\n}\n\nconst Pill = (props: { text: string; className?: string }) => (\n  <div className={'px-4 py-2 rounded-2xl ' + (props.className || '')}>{props.text}</div>\n);\n\nconst Hud = () => {\n  ticker.get();\n  const s = state.get();\n  const msg = toast.get();\n  if (!s) {\n    return <div className=\"mt-4 px-5 py-3 rounded-2xl bg-black/60 text-white text-xl\">Joining the farm...</div>;\n  }\n  const left = s.phaseEnd - getTime();\n  const isTagger = s.role === 'tagger';\n\n  let title = '';\n  let sub = '';\n  let tone = 'bg-black/60';\n  if (s.phase === 'lobby') {\n    title = 'LOBBY';\n    sub = s.total < 2 ? 'Waiting for more pigs to join...' : 'Round starts in ' + clock(left);\n    tone = 'bg-sky-800/80';\n  } else if (s.phase === 'playing') {\n    title = clock(left);\n    sub = isTagger ? 'Charge into pigs to tag them!' : 'Run! Survive until the timer runs out.';\n    tone = isTagger ? 'bg-red-800/80' : 'bg-emerald-800/80';\n  } else {\n    title = s.winner === 'taggers' ? 'TAGGERS WIN' : 'PIGS SURVIVE';\n    sub = 'Next lobby in ' + clock(left);\n    tone = s.winner === 'taggers' ? 'bg-red-800/85' : 'bg-emerald-800/85';\n  }\n\n  return (\n    <div className=\"flex flex-col items-center mt-4\">\n      <div className={'px-8 py-3 rounded-3xl text-white text-center ' + tone}>\n        <div className=\"text-4xl font-bold tracking-wide\">{title}</div>\n        <div className=\"text-lg opacity-90\">{sub}</div>\n      </div>\n      <div className=\"flex flex-row mt-3\">\n        <Pill\n          className={isTagger ? 'bg-red-600/90 text-white text-xl font-bold' : 'bg-pink-300/90 text-pink-950 text-xl font-bold'}\n          text={isTagger ? 'YOU ARE A TAGGER PIG' : 'YOU ARE A PIG'}\n        />\n        <div className=\"w-3\" />\n        <Pill className=\"bg-black/60 text-white text-xl font-bold\" text={'Pigs left: ' + s.runners + '   Taggers: ' + s.taggers} />\n      </div>\n      {msg ? (\n        <div className=\"mt-3 px-5 py-2 rounded-2xl bg-amber-400/90 text-amber-950 text-xl font-bold\">{msg}</div>\n      ) : null}\n    </div>\n  );\n};\n\ngame.guiService.show('pig-tag-hud', () => <Hud />, 'top');\nconsole.log('[pigtag] client hud ready');\n",
    "4091": "// Per-pig animation controller. Runs on every client, once per spawned pig.\ntype ObjLike = { id: number; getChild: (name: string) => ObjLike | null };\n\nlet root: ObjLike | null = null;\ntry {\n  root = script.parent as unknown as ObjLike | null;\n} catch (e) {\n  root = null; // the authoring source was cut to a template while this instance booted\n}\n\nconst body = root ? root.getChild('PigBody') : null;\nconst walkClock = root ? root.getChild('WalkClock') : null;\nconst idleClock = root ? root.getChild('IdleClock') : null;\nconst walkAnimator = root ? root.getChild('WalkAnimator') : null;\nconst idleAnimator = root ? root.getChild('IdleAnimator') : null;\n\nif (body && walkClock && idleClock && walkAnimator && idleAnimator) {\n  game.clockService.play(walkClock.id, 0);\n  game.clockService.play(idleClock.id, 0);\n  let walking = false;\n  setInterval(() => {\n    const v = game.objectService.getVelocityRelativeToGround(body.id);\n    const speed = Math.sqrt(v.x * v.x + v.z * v.z);\n    const shouldWalk = speed > 1.5;\n    if (shouldWalk !== walking) {\n      walking = shouldWalk;\n      game.animationService.smoothlyChangeWeight(walkAnimator.id, shouldWalk ? 100 : 0, 160);\n      game.animationService.smoothlyChangeWeight(idleAnimator.id, shouldWalk ? 0 : 100, 160);\n    }\n    if (shouldWalk) {\n      game.clockService.setSpeed(walkClock.id, Math.min(2.4, Math.max(0.7, speed / 13)));\n    }\n  }, 100);\n}\n"
  },
