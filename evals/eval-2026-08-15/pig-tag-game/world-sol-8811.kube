  "scriptRawCodeOfId": {
    "5": "'use server'\n\nconst LOBBY_MS = 30000;\nconst ROUND_MS = 300000;\nconst RESET_MS = 8000;\nconst lobbySpawns = [{ x: -8, y: 5, z: -8 }, { x: 8, y: 5, z: -8 }, { x: -8, y: 5, z: 8 }, { x: 8, y: 5, z: 8 }];\nconst arenaSpawns = [{ x: 95, y: 5, z: -90 }, { x: 265, y: 5, z: -90 }, { x: 95, y: 5, z: 90 }, { x: 265, y: 5, z: 90 }, { x: 130, y: 5, z: 35 }, { x: 230, y: 5, z: -35 }];\nlet phase = \"Lobby\";\nlet phaseEndsAt = getTime() + LOBBY_MS;\nconst tagged = new Set<number>();\n\nfunction descendants(root) {\n  const result = [];\n  const pending = [...root.getChildren()];\n  while (pending.length > 0) {\n    const next = pending.pop();\n    if (!next) continue;\n    result.push(next);\n    pending.push(...next.getChildren());\n  }\n  return result;\n}\n\nfunction allPlayers() {\n  return game.playerService.getAllPlayers();\n}\n\nfunction character(player) {\n  if (player.characterObjectId == null) return null;\n  return game.objectService.getObjectById(player.characterObjectId);\n}\n\nfunction teleport(player, position) {\n  const body = character(player);\n  if (body) game.objectService.moveObjectTo(body.id, position);\n}\n\nfunction recolor(player, isTagger) {\n  const body = character(player);\n  if (!body) return;\n  const color = isTagger ? { r: 0.95, g: 0.08, b: 0.06 } : { r: 1.0, g: 0.48, b: 0.62 };\n  for (const part of [body, ...descendants(body)]) {\n    if (\"color\" in part) part.color = color;\n  }\n}\n\nfunction resetToLobby() {\n  phase = \"Lobby\";\n  phaseEndsAt = getTime() + LOBBY_MS;\n  tagged.clear();\n  allPlayers().forEach((player, index) => {\n    recolor(player, false);\n    teleport(player, lobbySpawns[index % lobbySpawns.length]);\n  });\n  console.log(\"PIG TAG: Lobby started - round begins in 30 seconds\");\n}\n\nfunction startRound() {\n  const players = allPlayers();\n  if (players.length === 0) {\n    resetToLobby();\n    return;\n  }\n  phase = \"Round\";\n  phaseEndsAt = getTime() + ROUND_MS;\n  tagged.clear();\n  const firstTagger = players[Math.floor(Math.random() * players.length)];\n  tagged.add(firstTagger.id);\n  players.forEach((player, index) => {\n    teleport(player, arenaSpawns[index % arenaSpawns.length]);\n    recolor(player, tagged.has(player.id));\n  });\n  console.log(\"PIG TAG: Round started with \" + players.length + \" players. Survive the red infected pigs for 5 minutes.\");\n}\n\nfunction finishRound(message) {\n  if (phase !== \"Round\") return;\n  phase = \"Results\";\n  phaseEndsAt = getTime() + RESET_MS;\n  console.log(\"PIG TAG RESULT: \" + message);\n}\n\nfunction playerForCollisionObject(object) {\n  return allPlayers().find((player) => {\n    const body = character(player);\n    return body && (body.id === object.id || descendants(body).some((part) => part.id === object.id));\n  });\n}\n\ngame.collisionService.addCollisionListener((objectA, objectB) => {\n  if (phase !== \"Round\") return;\n  const playerA = playerForCollisionObject(objectA);\n  const playerB = playerForCollisionObject(objectB);\n  if (!playerA || !playerB || playerA.id === playerB.id) return;\n  if (tagged.has(playerA.id) && !tagged.has(playerB.id)) {\n    tagged.add(playerB.id);\n    recolor(playerB, true);\n  } else if (tagged.has(playerB.id) && !tagged.has(playerA.id)) {\n    tagged.add(playerA.id);\n    recolor(playerA, true);\n  }\n  const players = allPlayers();\n  if (players.length > 0 && players.every((player) => tagged.has(player.id))) {\n    finishRound(\"THE TAGGERS WIN - every pig was infected!\");\n  }\n});\n\nsetInterval(() => {\n  if (getTime() < phaseEndsAt) return;\n  if (phase === \"Lobby\") startRound();\n  else if (phase === \"Round\") finishRound(\"THE PIGS WIN - survivors lasted 5 minutes!\");\n  else resetToLobby();\n}, 250);\nresetToLobby();\n",
    "6": "const elapsed = createState(0);\nsetInterval(() => elapsed.set(getTime()), 250);\n\nfunction Hud() {\n  const cycle = elapsed.get() % 338000;\n  const inLobby = cycle < 30000;\n  const inRound = cycle >= 30000 && cycle < 330000;\n  const remainingMs = inLobby ? 30000 - cycle : inRound ? 330000 - cycle : 338000 - cycle;\n  const seconds = Math.max(0, Math.ceil(remainingMs / 1000));\n  const minutes = Math.floor(seconds / 60);\n  const displaySeconds = String(seconds % 60).padStart(2, \"0\");\n  const title = inLobby ? \"LOBBY\" : inRound ? \"PIG TAG\" : \"ROUND OVER\";\n  const subtitle = inLobby\n    ? \"Round begins soon • one pig will become the red tagger\"\n    : inRound\n      ? \"Pink pigs: survive!  Red pigs: infect everyone!\"\n      : \"Returning to the lobby...\";\n  return <div className=\"mt-6 flex w-[520px] flex-col items-center rounded-[24px] bg-black/70 px-7 py-4 text-white shadow-2xl\">\n    <div className=\"text-[30px] font-black tracking-[6px] text-pink-300\">{title}</div>\n    <div className=\"mt-1 text-[42px] font-black\">{minutes}:{displaySeconds}</div>\n    <div className=\"mt-1 text-center text-[16px] font-semibold\">{subtitle}</div>\n  </div>;\n}\n\ngame.guiService.show(\"pig-tag-hud\", <Hud />, \"top\");",
    "45": "'use server'\n\nconst pigRootIdOfPlayerId = new Map<number, number>();\nconst lobbySpawns = [\n  { x: -8, y: 5, z: -8 },\n  { x: 8, y: 5, z: -8 },\n  { x: -8, y: 5, z: 8 },\n  { x: 8, y: 5, z: 8 },\n];\nlet nextSpawnIndex = 0;\n\nconst world = game.objectService.getObjectByName(\"world\");\nconst pigSource = game.objectService.getObjectByName(\"PigCharacterSource\");\nif (!world || !pigSource) {\n  throw new Error(\"Pig character source or world group is missing\");\n}\ngame.templateService.cutObjectToTemplate(pigSource.id, \"pig-character\");\n\nconst spawnPig = (player) => {\n  const pigRoot = game.templateService.pasteTemplate(\"pig-character\", world.id);\n  const body = pigRoot.getChild(\"PigBody\");\n  const head = body ? body.getChild(\"PigHead\") : null;\n  if (!body || !head) {\n    game.objectService.deleteObject(pigRoot.id);\n    console.log(\"PIG TAG ERROR: Pig template is missing PigBody or PigHead\");\n    return;\n  }\n\n  const spawn = lobbySpawns[nextSpawnIndex % lobbySpawns.length];\n  nextSpawnIndex += 1;\n  game.objectService.moveObjectTo(body.id, spawn);\n  game.objectService.setObjectAnchored(body.id, false);\n  game.objectService.setObjectDensity(body.id, 1);\n\n  player.characterObjectId = body.id;\n  player.headObjectId = head.id;\n  player.physicsControls = {\n    jumpHeight: 3,\n    stepHeight: 2,\n    speed: 18,\n    acceleration: 90,\n  };\n  pigRootIdOfPlayerId.set(player.id, pigRoot.id);\n  console.log(\"PIG TAG: Spawned controllable pig for \" + player.userid);\n};\n\ngame.objectService.addObjectCreatedListener((player) => {\n  spawnPig(player);\n}, \"player\");\n\ngame.objectService.addObjectDeletedListener((playerId) => {\n  const pigRootId = pigRootIdOfPlayerId.get(playerId);\n  if (pigRootId === undefined) return;\n  game.objectService.deleteObject(pigRootId);\n  pigRootIdOfPlayerId.delete(playerId);\n}, \"player\");\n"
  },
  "physicsInfo3DOfId": {
    "36": {
      "location": {
        "position": [
          -0.8,
