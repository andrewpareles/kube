  "scriptRawCodeOfId": {
    "26": "\"use server\";\n\nconst LOBBY_MS = 30_000;\nconst ROUND_MS = 300_000;\nlet taggedPlayerIds = new Set<number>();\nlet roundEndsAt = 0;\nlet phase = \"lobby\";\n\nfunction players() { return game.playerService.getAllPlayers(); }\n\nfunction setPigLook(player: any, isTagger: boolean) {\n  const body = game.objectService.getObjectById(player.characterObjectId);\n  if (!body) return;\n  body.name = isTagger ? \"RED PIG TAGGER\" : \"Pink Pig\";\n  if (body.type === \"brick\" || body.type === \"ball\" || body.type === \"cylinder\") {\n    body.color = isTagger ? { r: 0.9, g: 0.08, b: 0.08 } : { r: 1, g: 0.55, b: 0.68 };\n  }\n}\n\nfunction startRound() {\n  const all = players();\n  if (all.length === 0) { setTimeout(startLobby, 1000); return; }\n  phase = \"round\";\n  taggedPlayerIds = new Set([all[Math.floor(Math.random() * all.length)].id]);\n  roundEndsAt = getTime() + ROUND_MS;\n  for (const player of all) setPigLook(player, taggedPlayerIds.has(player.id));\n  console.log(\"PIG TAG: round started — one red tagger, survive 5 minutes!\");\n  setTimeout(checkRound, 1000);\n}\n\nfunction tag(playerId: number) {\n  if (phase !== \"round\" || taggedPlayerIds.has(playerId)) return;\n  taggedPlayerIds.add(playerId);\n  const player = players().find((p: any) => p.id === playerId);\n  if (player) setPigLook(player, true);\n  console.log(\"PIG TAG: a pig was tagged!\");\n}\n\nfunction checkRound() {\n  if (phase !== \"round\") return;\n  const all = players();\n  if (all.length > 0 && taggedPlayerIds.size >= all.length) {\n    console.log(\"PIG TAG: taggers win!\");\n    startLobby();\n  } else if (getTime() >= roundEndsAt) {\n    console.log(\"PIG TAG: surviving pigs win!\");\n    startLobby();\n  } else setTimeout(checkRound, 1000);\n}\n\nfunction startLobby() {\n  phase = \"lobby\";\n  taggedPlayerIds.clear();\n  for (const player of players()) setPigLook(player, false);\n  console.log(\"PIG TAG: lobby open — round begins in 30 seconds.\");\n  setTimeout(startRound, LOBBY_MS);\n}\n\ngame.collisionService.addCollisionListener((a: any, b: any) => {\n  if (phase !== \"round\") return;\n  const all = players();\n  const aPlayer = all.find((p: any) => p.characterObjectId === a.id);\n  const bPlayer = all.find((p: any) => p.characterObjectId === b.id);\n  if (!aPlayer || !bPlayer) return;\n  if (taggedPlayerIds.has(aPlayer.id)) tag(bPlayer.id);\n  if (taggedPlayerIds.has(bPlayer.id)) tag(aPlayer.id);\n});\n\nstartLobby();"
  },
