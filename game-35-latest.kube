  "scriptRawCodeOfId": {
    "480": "'use client'\n\nimport { reportTag } from './game'\n\ntype ClientState = {\n  phase: 'lobby' | 'round' | 'result'\n  endsAt: number\n  myUserId: string\n  myCharacterId: number | null\n  youAreTagger: boolean\n  runnerCharacters: { userid: string; characterId: number }[]\n  taggerCount: number\n  runnerCount: number\n  playerCount: number\n  minPlayers: number\n  winner: string | null\n  taggedAt: number\n}\n\nconst state = createState<ClientState | null>(null)\nconst clock = createState<number>(getTime())\n\nsetInterval(() => {\n  clock.set(getTime())\n}, 200)\n\n// createState() itself is faithful (get() returns the initial value), but a bad `set()` can\n// still poison the store, and `=== null` alone would not catch an undefined. Every read goes\n// through these so a malformed push degrades to the placeholder instead of killing the script.\nconst readState = () => {\n  const s = state.get()\n  if (s === null || s === undefined) return null\n  return s\n}\n\nconst readClock = () => {\n  const t = clock.get()\n  if (typeof t !== 'number') return getTime()\n  return t\n}\n\n/**\n * Reads the payload from whichever slot it lands in, so this works against both the old and\n * the fixed engine. Before the fix, __callJsClientFnFromServer__ serialised only `args` and\n * dropped userId, so the payload arrived in the FIRST slot; with userId now forwarded it\n * arrives in the second, as declared. Once the client binary is rebuilt this can collapse to\n * a plain `(userid: string, payload: ClientState)`.\n */\nexport async function pushState(userid: unknown, payload?: unknown) {\n  const raw = payload === undefined || payload === null ? userid : payload\n  if (raw === null || typeof raw !== 'object') return\n  const next = raw as ClientState\n  if (typeof next.phase !== 'string' || typeof next.endsAt !== 'number') return\n  state.set(next)\n}\n\n// ---------------------------------------------------------------- tagging\n\ntype WorldObject = NonNullable<ReturnType<typeof game.objectService.getObjectById>>\n\nconst rigidRootFor = (object: WorldObject) => {\n  let cur: WorldObject | null = object\n  while (cur !== null && cur.type !== 'rigidGroup') cur = cur.parent\n  return cur\n}\n\ngame.collisionService.addCollisionListener((object1, object2) => {\n  const s = readState()\n  if (s === null || s.phase !== 'round' || !s.youAreTagger || s.myCharacterId === null) return\n  const a = rigidRootFor(object1)\n  const b = rigidRootFor(object2)\n  if (a === null || b === null) return\n  let otherId: number | null = null\n  if (a.id === s.myCharacterId) otherId = b.id\n  else if (b.id === s.myCharacterId) otherId = a.id\n  if (otherId === null) return\n  for (const runner of s.runnerCharacters) {\n    if (runner.characterId === otherId) {\n      reportTag(s.myUserId, runner.userid)\n      return\n    }\n  }\n})\n\n// ---------------------------------------------------------------- hud\n\nconst clamp0 = (ms: number) => (ms < 0 ? 0 : ms)\n\nconst mmss = (ms: number) => {\n  const total = Math.ceil(clamp0(ms) / 1000)\n  const m = Math.floor(total / 60)\n  const s = total % 60\n  return m + ':' + (s < 10 ? '0' + s : '' + s)\n}\n\nconst STRIP = 'mt-3 flex items-center gap-3 rounded-full bg-black/35 px-4 py-1.5'\nconst STAGE = 'text-xs font-semibold uppercase tracking-widest text-white/60'\n\n/** One quiet strip: a role dot, the stage, the clock, and how many pigs are left. */\nconst StatusStrip = () => {\n  const s = readState()\n  if (s === null) {\n    return (\n      <div className={STRIP}>\n        <div className=\"h-2 w-2 rounded-full bg-white/30\" />\n        <div className={STAGE}>Pig Tag</div>\n      </div>\n    )\n  }\n\n  const left = clamp0(s.endsAt - readClock())\n  const short = s.playerCount < s.minPlayers\n\n  let stage = 'Lobby'\n  let detail = s.playerCount + ' in the pen'\n  let dot = 'bg-white/40'\n\n  if (s.phase === 'lobby' && short) {\n    detail = 'need ' + s.minPlayers\n  } else if (s.phase === 'round') {\n    stage = s.youAreTagger ? 'Tagger' : 'Pig'\n    detail = s.runnerCount + ' left'\n    dot = s.youAreTagger ? 'bg-red-500' : 'bg-pink-300'\n  } else if (s.phase === 'result') {\n    stage = s.winner === 'pigs' ? 'Pigs won' : 'Taggers won'\n    detail = 'next round'\n    dot = s.winner === 'pigs' ? 'bg-pink-300' : 'bg-red-500'\n  }\n\n  return (\n    <div className={STRIP}>\n      <div className={'h-2 w-2 rounded-full ' + dot} />\n      <div className={STAGE}>{stage}</div>\n      {s.phase === 'lobby' && short ? null : (\n        <div className=\"text-sm font-bold text-white/90\">{mmss(left)}</div>\n      )}\n      <div className=\"text-xs text-white/45\">{detail}</div>\n    </div>\n  )\n}\n\n/** Transient only: the moment you get tagged, and the end-of-round call. */\nconst CenterBanner = () => {\n  const s = readState()\n  if (s === null) return null\n\n  if (s.phase === 'result') {\n    const pigsWon = s.winner === 'pigs'\n    return (\n      <div className={'rounded-2xl px-8 py-4 ' + (pigsWon ? 'bg-pink-400/85' : 'bg-red-700/85')}>\n        <div className=\"text-3xl font-black text-white\">\n          {pigsWon ? 'PIGS SURVIVED' : 'TAGGERS WIN'}\n        </div>\n      </div>\n    )\n  }\n\n  if (s.phase === 'round' && s.taggedAt > 0 && readClock() - s.taggedAt < 3000) {\n    return (\n      <div className=\"rounded-2xl bg-red-700/85 px-8 py-4\">\n        <div className=\"text-3xl font-black text-white\">TAGGED \u2014 you hunt now</div>\n      </div>\n    )\n  }\n\n  return null\n}\n\ngame.guiService.show('pigtag-status', () => <StatusStrip />, 'top')\ngame.guiService.show('pigtag-center', () => <CenterBanner />, 'center')\n",
    "479": "// Drives PlatformScripted by hand, once per physics step, as a side-by-side comparison\n// against PlatformAnimated next to it \u2014 same axis (yaw, so the deck stays parallel to the\n// floor), same 60 deg/s, driven by a PropertyAnimator.\n//\n// Note this is deliberately the discouraged pattern: writing an object's transform every tick\n// sends a transform update to every client each step, where the PropertyAnimator replicates\n// once and is then evaluated locally on each client.\n\nconst SPIN_DEGREES_PER_SEC = 60\n\nconst platform = game.objectService.getObjectByName('PlatformScripted')\n\nif (platform !== null && platform.type === 'brick') {\n  const platformId = platform.id\n  const home = {\n    x: platform.location.position.x,\n    y: platform.location.position.y,\n    z: platform.location.position.z,\n  }\n  const startedAt = getTime()\n\n  const spinForever = async () => {\n    while (true) {\n      await tick()\n      const live = game.objectService.getObjectById(platformId)\n      if (live === null || live.type !== 'brick') return\n      const elapsedSec = (getTime() - startedAt) / 1000\n      // re-pin the position every step so nothing can nudge it off its axis\n      live.location = {\n        position: home,\n        rotation: { x: 0, y: (SPIN_DEGREES_PER_SEC * elapsedSec) % 360, z: 0 },\n      }\n      // Rapier derives the platform's linear and angular velocity from this kinematic target.\n    }\n  }\n\n  spinForever()\n}\n\n// Third comparison: PlatformSpun is anchored, so kinematic, and is handed an angular velocity ONCE.\n// Nothing writes its transform after this - the engine re-applies that velocity as target motion every\n// step, which is what makes setting a velocity mean \"keep moving\" for a kinematic object.\nconst spun = game.objectService.getObjectByName('PlatformSpun')\nif (spun !== null && spun.type === 'brick') {\n  spun.movement = {\n    velocity: { x: 0, y: 0, z: 0 },\n    angularVelocity: { x: 0, y: SPIN_DEGREES_PER_SEC, z: 0 },\n  }\n}\n",
    "481": "'use server'\n\nimport { pushState } from './hud'\n\ntype Phase = 'lobby' | 'round' | 'result'\n\nconst LOBBY_MS = 5000\nconst ROUND_MS = 300000\nconst RESULT_MS = 10000\nconst TAG_RANGE = 15\nconst MIN_PLAYERS = 2\n\nconst MAP_SPAWNS = [\n  { x: 8.2, z: 153.0 }, { x: 9.8, z: -131.5 }, { x: 129.2, z: 5.6 }, { x: -81.7, z: 12.1 },\n  { x: -34.8, z: 70.0 }, { x: 26.8, z: 69.0 }, { x: 4.3, z: -72.1 }, { x: 82.9, z: -28.6 },\n  { x: -130.6, z: 40.5 }, { x: 61.2, z: 172.5 }, { x: -38.5, z: -165.5 }, { x: 174.7, z: -109.5 },\n]\nconst LOBBY_SPAWNS = [\n  { x: 1030.0, z: 0.0 }, { x: 1024.3, z: 17.6 }, { x: 1009.3, z: 28.5 }, { x: 990.7, z: 28.5 },\n  { x: 975.7, z: 17.6 }, { x: 970.0, z: 0.0 }, { x: 975.7, z: -17.6 }, { x: 990.7, z: -28.5 },\n  { x: 1009.3, z: -28.5 }, { x: 1024.3, z: -17.6 },\n]\n\nconst PIG_PINK = { r: 0.96, g: 0.68, b: 0.72 }\nconst PIG_TRIM = { r: 0.84, g: 0.47, b: 0.54 }\nconst TAG_BODY = { r: 0.88, g: 0.11, b: 0.1 }\nconst TAG_TRIM = { r: 0.45, g: 0.02, b: 0.05 }\n\nlet phase: Phase = 'lobby'\nlet phaseEndsAt = getTime() + LOBBY_MS\nlet winner: string | null = null\n\nconst taggers = new Set<string>()\nconst runners = new Set<string>()\nconst charRootByUser = new Map<string, number>()\nconst userByPlayerObject = new Map<number, string>()\nconst baseSpeed = new Map<string, number>()\nconst taggedAt = new Map<string, number>()\nlet spawnCursor = 0\nlet pasteCounter = 0\n\n// ---------------------------------------------------------------- helpers\n\n// the API's object types are not in global scope, so derive the ones we need\ntype PlayerObject = ReturnType<typeof game.playerService.getAllPlayers>[number]\n\nconst charactersFolder = () => game.objectService.getObjectByName('Characters')\n\n/** This player's live pig body, narrowed to a RigidGroup so physics fields are readable. */\nconst bodyFor = (userid: string) => {\n  const rootId = charRootByUser.get(userid)\n  if (rootId === undefined) return null\n  const root = game.objectService.getObjectById(rootId)\n  if (root === null) return null\n  const body = root.getChild('PigBody')\n  if (body === null || body.type !== 'rigidGroup') return null\n  return body\n}\n\nconst applyLook = (rootId: number, isTagger: boolean) => {\n  const root = game.objectService.getObjectById(rootId)\n  if (root === null) return\n  const body = root.getChild('PigBody')\n  if (body === null) return\n  for (const part of body.getChildren()) {\n    if (part.type !== 'brick' && part.type !== 'cylinder') continue\n    const n = part.name\n    if (n === 'EyeL' || n === 'EyeR') continue\n    if (n === 'Spike1' || n === 'Spike2' || n === 'Spike3') {\n      part.color = TAG_TRIM\n      part.opacity = isTagger ? 1 : 0\n      continue\n    }\n    const trim = n === 'Snout' || n === 'EarL' || n === 'EarR' || n === 'Tail'\n    if (isTagger) part.color = trim ? TAG_TRIM : TAG_BODY\n    else part.color = trim ? PIG_TRIM : PIG_PINK\n  }\n}\n\nconst applySpeed = (player: PlayerObject, isTagger: boolean) => {\n  const base = baseSpeed.get(player.userid)\n  if (base === undefined) return\n  const c = player.physicsControls\n  player.physicsControls = {\n    jumpHeight: Math.max(c.jumpHeight, 3),\n    stepHeight: Math.max(c.stepHeight, 2.2),\n    speed: base * (isTagger ? 1.3 : 1.15),\n    acceleration: c.acceleration,\n  }\n}\n\nconst log = (message: string) => {\n  console.log('[pigtag] ' + message)\n}\n\nconst playerFor = (userid: string) => {\n  for (const p of game.playerService.getAllPlayers()) {\n    if (p.userid === userid) return p\n  }\n  return null\n}\n\n/**\n * Respawn rather than move, because this build cannot teleport a player's own character.\n *\n * On master the client is the sole authority on its character's position: it uploads that\n * body's physics every input tick and crates/server/src/server.rs applies it verbatim, so a\n * server-side moveObjectTo is overwritten within one tick.\n *\n * The real fix (ControlState + control epoch, which drops client inputs that raced a server\n * override) exists on the `asdasdas` branch \u2014 commits a24aca9f / 7bf83f25 \u2014 but is not merged\n * into master. If those land, this whole function collapses back to a plain moveObjectTo.\n *\n * Swapping in a new body works today because the server drops uploads whose\n * controlled_object_id no longer matches the player's characterObjectId.\n */\nconst respawnPlayerAt = (player: PlayerObject, x: number, z: number) => {\n  // EXPERIMENT: runners get the intuitive treatment \u2014 just move the body they already have.\n  // Taggers still get the body swap. If the doc comment below is right, runners will snap back\n  // to where they were within a tick, because their own client re-uploads the old position.\n  if (!taggers.has(player.userid) && charRootByUser.get(player.userid) !== undefined) {\n    const existingBody = bodyFor(player.userid)\n    if (existingBody !== null) {\n      game.objectService.moveObjectTo(existingBody.id, { x: x, y: 1, z: z })\n      log('MOVED (not respawned) ' + player.username + ' to ' + Math.round(x) + ',' + Math.round(z))\n      return\n    }\n  }\n\n  const folder = charactersFolder()\n  if (folder === null) {\n    log('respawn: no Characters folder')\n    return\n  }\n  const previousRootId = charRootByUser.get(player.userid)\n\n  // Every paste needs a name no earlier pig has used. The client keys a script by its\n  // object path, so a second Pig_<username>/pig_anim collides with the copy being replaced\n  // and never boots, which leaves the respawned pig with no animation driver at all.\n  pasteCounter = pasteCounter + 1\n  const root = game.templateService.pasteTemplate('pig', folder.id)\n  root.name = 'Pig_' + player.username + '_' + pasteCounter\n  const body = root.getChild('PigBody')\n  if (body === null) {\n    log('respawn: pasted template has no PigBody')\n    return\n  }\n  const head = body.getChild('Head')\n\n  game.objectService.moveObjectTo(body.id, { x: x, y: 1, z: z })\n  game.objectService.setObjectAnchored(root.id, false)\n\n  // repoint control before deleting the old body, so there is no tick where the player\n  // controls nothing\n  player.characterObjectId = body.id\n  if (head !== null) player.headObjectId = head.id\n  charRootByUser.set(player.userid, root.id)\n\n  if (previousRootId !== undefined) game.objectService.deleteObject(previousRootId)\n  log('respawned ' + player.username + ' at ' + Math.round(x) + ',' + Math.round(z))\n}\n\nconst spreadOut = (players: PlayerObject[], spots: { x: number; z: number }[]) => {\n  for (let i = 0; i < players.length; i++) {\n    const spot = spots[i % spots.length]\n    const ring = Math.floor(i / spots.length)\n    respawnPlayerAt(players[i], spot.x + ring * 6, spot.z + ring * 6)\n  }\n}\n\nconst setRole = (userid: string, isTagger: boolean) => {\n  if (isTagger) {\n    runners.delete(userid)\n    taggers.add(userid)\n  } else {\n    taggers.delete(userid)\n    runners.add(userid)\n  }\n  const rootId = charRootByUser.get(userid)\n  if (rootId !== undefined) applyLook(rootId, isTagger)\n  for (const p of game.playerService.getAllPlayers()) {\n    if (p.userid === userid) applySpeed(p, isTagger)\n  }\n}\n\n// ---------------------------------------------------------------- lifecycle\n\nconst source = game.objectService.getObjectByName('PigCharacter')\nif (source !== null) game.templateService.cutObjectToTemplate(source.id, 'pig')\n\nconst spawnCharacter = (player: PlayerObject) => {\n  const spots = phase === 'round' ? MAP_SPAWNS : LOBBY_SPAWNS\n  const spot = spots[spawnCursor % spots.length]\n  spawnCursor = spawnCursor + 1\n  respawnPlayerAt(player, spot.x, spot.z)\n}\n\ngame.objectService.addObjectCreatedListener((player) => {\n  userByPlayerObject.set(player.id, player.userid)\n  baseSpeed.set(player.userid, player.physicsControls.speed)\n  spawnCharacter(player)\n  // a pig that shows up mid-round joins the hunt, zombie-tag style\n  setRole(player.userid, phase === 'round')\n  push()\n}, 'player')\n\ngame.objectService.addObjectDeletedListener((playerObjectId) => {\n  const userid = userByPlayerObject.get(playerObjectId)\n  if (userid === undefined) return\n  userByPlayerObject.delete(playerObjectId)\n  const rootId = charRootByUser.get(userid)\n  if (rootId !== undefined) game.objectService.deleteObject(rootId)\n  charRootByUser.delete(userid)\n  taggers.delete(userid)\n  runners.delete(userid)\n  baseSpeed.delete(userid)\n  taggedAt.delete(userid)\n  push()\n}, 'player')\n\n// ---------------------------------------------------------------- rounds\n\nconst startRound = () => {\n  const players = game.playerService.getAllPlayers()\n  if (players.length < MIN_PLAYERS) {\n    // this is the silent path that looks like \"the timer ran out and nothing happened\"\n    log('lobby timer expired but only ' + players.length + ' player(s) \u2014 need ' + MIN_PLAYERS +\n      '. Restarting the lobby countdown; press \"Add user\" in Play mode to start a round.')\n    phaseEndsAt = getTime() + LOBBY_MS\n    return\n  }\n  log('starting round with ' + players.length + ' players')\n  const ids = players.map((p) => p.userid)\n  taggers.clear()\n  runners.clear()\n  taggedAt.clear()\n  winner = null\n  spawnCursor = 0\n  // Roles first: respawnPlayerAt branches on them now, so it must know the tagger before\n  // anyone is moved.\n  const it = Math.floor(Math.random() * ids.length)\n  for (let i = 0; i < ids.length; i++) setRole(ids[i], i === it)\n  spreadOut(players, MAP_SPAWNS)\n  // The tagger got a fresh body from the swap, so its colors need re-applying.\n  for (const id of ids) {\n    const rootId = charRootByUser.get(id)\n    if (rootId !== undefined) applyLook(rootId, taggers.has(id))\n  }\n  phase = 'round'\n  phaseEndsAt = getTime() + ROUND_MS\n  log('round live: 1 tagger, ' + runners.size + ' runners')\n}\n\nconst endRound = (who: string) => {\n  winner = who\n  phase = 'result'\n  phaseEndsAt = getTime() + RESULT_MS\n}\n\nconst backToLobby = () => {\n  phase = 'lobby'\n  winner = null\n  phaseEndsAt = getTime() + LOBBY_MS\n  taggedAt.clear()\n  spawnCursor = 0\n  const players = game.playerService.getAllPlayers()\n  spreadOut(players, LOBBY_SPAWNS)\n  for (const p of players) setRole(p.userid, false)\n}\n\nexport async function reportTag(taggerUserId: string, victimUserId: string) {\n  if (typeof taggerUserId !== 'string' || typeof victimUserId !== 'string') return\n  if (phase !== 'round') return\n  if (!taggers.has(taggerUserId) || !runners.has(victimUserId)) return\n  const a = bodyFor(taggerUserId)\n  const b = bodyFor(victimUserId)\n  if (a === null || b === null) return\n  const dx = a.location.position.x - b.location.position.x\n  const dy = a.location.position.y - b.location.position.y\n  const dz = a.location.position.z - b.location.position.z\n  if (dx * dx + dy * dy + dz * dz > TAG_RANGE * TAG_RANGE) return\n  taggedAt.set(victimUserId, getTime())\n  setRole(victimUserId, true)\n  push()\n}\n\n// ---------------------------------------------------------------- state out\n\nconst push = () => {\n  const runnerList: { userid: string; characterId: number }[] = []\n  for (const id of runners) {\n    const body = bodyFor(id)\n    if (body !== null) runnerList.push({ userid: id, characterId: body.id })\n  }\n  for (const p of game.playerService.getAllPlayers()) {\n    const body = bodyFor(p.userid)\n    pushState(p.userid, {\n      phase: phase,\n      endsAt: phaseEndsAt,\n      myUserId: p.userid,\n      myCharacterId: body === null ? null : body.id,\n      youAreTagger: taggers.has(p.userid),\n      runnerCharacters: runnerList,\n      taggerCount: taggers.size,\n      runnerCount: runners.size,\n      playerCount: game.playerService.getAllPlayers().length,\n      minPlayers: MIN_PLAYERS,\n      winner: winner,\n      taggedAt: taggedAt.get(p.userid) ?? 0,\n    })\n  }\n}\n\nlet lastResync = 0\n\nsetInterval(() => {\n  const now = getTime()\n  if (phase === 'lobby' && now >= phaseEndsAt) {\n    startRound()\n    push()\n  } else if (phase === 'round') {\n    if (runners.size === 0) {\n      endRound('taggers')\n      push()\n    } else if (now >= phaseEndsAt) {\n      endRound('pigs')\n      push()\n    }\n  } else if (phase === 'result' && now >= phaseEndsAt) {\n    backToLobby()\n    push()\n  }\n  if (now - lastResync > 2000) {\n    lastResync = now\n    push()\n  }\n}, 250)\n",
    "4": "// Drives this pig's walk cycle locally from its own body velocity, so legs react\n// without a server round trip. Lives inside the character template, one per pig.\nconst root = script.parent\n\nlet walking = false\nlet started = false\nlet missingTicks = 0\n\nsetInterval(async () => {\n  if (root === null) return\n  const body = root.getChild('PigBody')\n  const animator = root.getChild('WalkAnimator')\n  const clock = root.getChild('WalkClock')\n  if (body === null || animator === null || clock === null) {\n    // A respawn replaced this pig and deleted its objects. Nothing here will ever come back,\n    // so retire this copy instead of leaving an interval polling deleted ids forever.\n    missingTicks = missingTicks + 1\n    if (missingTicks > 20) await stopScript()\n    return\n  }\n  missingTicks = 0\n  if (body.type !== 'rigidGroup') return\n\n  if (!started) {\n    started = true\n    game.clockService.play(clock.id, 0)\n  }\n\n  const v = game.objectService.getVelocityRelativeToGround(body.id)\n  const speed = Math.sqrt(v.x * v.x + v.z * v.z)\n  game.clockService.setSpeed(clock.id, Math.min(2.4, Math.max(0.7, speed / 9)))\n\n  const moving = speed > 1.5\n  if (moving !== walking) {\n    walking = moving\n    game.animationService.smoothlyChangeWeight(animator.id, moving ? 100 : 0, 180, 'EaseInOut')\n  }\n}, 100)\n"
  },
