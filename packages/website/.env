# Every public setting, for the website and the Rust programs. Next.js loads this file, and the Rust programs compile it in.
# Secrets aren't in git. They're in Infisical, which syncs them to Vercel and GitHub and writes .env.local on your computer (README_SECRETS.md).
# Browser code reads NEXT_PUBLIC_ copies of some of these, which next.config.ts makes.


# supabase
SUPABASE_URL=https://cackpkffqqxhvaqdsnkp.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_Kre-2O7JEdidgU8_8Xc83Q_2WeyH-J7

SITE_URL=https://kube.new
# port is automatic since it's web

# The Google OAuth client set on Supabase's Google provider, which Google One Tap signs in with too.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=27369912984-4fkjk9qjvocf7piqd35527q4i4bnlvn4.apps.googleusercontent.com

# posthog (website and game analytics)
POSTHOG_KEY=phc_Adrx3eempzUQrGxGswVPNxArPW8BGAdnfudiiLhaDqCi

# edgegap
EDGEGAP_APPLICATION_NAME=kube-new-server
# host is provided by Edgegap
# edgegap lets us listen on any port (internal), they assign a public port for us to use that's different from this
EDGEGAP_INTERNAL_PORT=7777
EDGEGAP_WEBHOOK_BASE_URL=https://kube.new
EDGEGAP_EDITOR_APPLICATION_NAME=kube-new-editor-server
EDGEGAP_EDITOR_VERSION_NAME=prod


# ------ game server ------

# Stuff passed in by elsewhere:
# GAME_ID is injected when we spin up the server ourselves from the website, we get it from `running_servers` on supabase.
# GAMEWORLD_VERSION_NUM is injected when we spin up the server ourselves from the website, we get it from `running_servers` on supabase.
# ARBITRIUM_REQUEST_ID is injected by Edgegap itself.

# Its secrets come from the website, which passes them from Vercel when it starts the server (see README_SECRETS.md).
# S3 storage as AWS user kube-new-servers, shared with the editor: reads, writes and deletes in kube-new-public and kube-new-private.


# ------ editor server ------

EDITOR_SERVER_PORT=8080
EDITOR_CHAT_PORT=8081
EDITOR_PLAYTEST_PORT=5000
# The editor's AI chat calls Bedrock in this region.
AWS_REGION=us-east-1
# Edgegap supplies ARBITRIUM_REQUEST_ID, ARBITRIUM_DELETE_URL and ARBITRIUM_DELETE_TOKEN, and the website supplies GAME_ID when it starts an editor.

# Its secrets come from the website, which passes them from Vercel when it starts an editor, and from packages/website/.env.local to the dev editor (see README_SECRETS.md).
# S3 storage as AWS user kube-new-servers, shared with the game server: reads, writes and deletes in kube-new-public and kube-new-private.

# Playtest screenshots draw players' GUI with headless Chromium. The container installs it on PATH; local dev passes its own.
CHROMIUM_PATH=chromium


# ------ desktop app ------

